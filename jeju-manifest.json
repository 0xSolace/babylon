{
  "$schema": "../../../packages/config/jeju-manifest.schema.json",
  "name": "babylon",
  "displayName": "Babylon",
  "version": "2.0.0",
  "type": "vendor",
  "description": "Fully decentralized prediction markets and social game with AI agents, governed by AI CEO (MonkeyKing)",
  "commands": {
    "dev": "bun run dev",
    "build": "bun run build",
    "build:static": "bun run build:static",
    "build:worker": "bun build apps/api/dws-worker.ts --outdir dist/worker --target bun --minify",
    "test": "bun run test",
    "start": "bun run start",
    "start:worker": "bun run start",
    "deploy": "bun run deploy:frontend",
    "deploy:testnet": "bun run deploy:testnet:all",
    "deploy:mainnet": "bun run deploy:mainnet:all",
    "deploy:contracts": "forge script script/DeployDAO.s.sol --broadcast",
    "seed": "bun run packages/contracts/script/auto-seed.ts",
    "training:status": "bun run packages/training/scripts/status.ts",
    "ceo:monitor": "bun run packages/agents/scripts/monitor-ceo.ts"
  },
  "ports": {
    "main": 5007,
    "api": 5009,
    "a2a": 5008,
    "training": 5010
  },
  "architecture": {
    "type": "hybrid",
    "runtime": "workerd",
    "frontend": {
      "type": "spa",
      "builder": "bun",
      "entrypoint": "apps/web/index.html",
      "outputDir": "apps/web/dist"
    },
    "backend": {
      "type": "elysia",
      "entrypoint": "apps/api/dws-worker.ts",
      "outputDir": "dist/worker"
    }
  },
  "dependencies": [
    "eqlite",
    "cache-service",
    "storage",
    "kms",
    "oauth3",
    "contracts",
    "compute",
    "keepalive"
  ],
  "contracts": {
    "manifest": "contracts/jeju-contracts.json",
    "autoDeploy": true,
    "deployOrder": [
      "BabylonTreasury",
      "BabylonAgentVault",
      "BabylonDAO",
      "TrainingOrchestrator"
    ]
  },
  "enabled": true,
  "autoStart": true,
  "tags": [
    "game",
    "prediction-markets",
    "social",
    "ai-agents",
    "decentralized",
    "dao",
    "ai-ceo"
  ],
  "jns": {
    "name": "babylon.jeju",
    "description": "Decentralized prediction markets and social game with AI agents, governed by AI CEO",
    "url": "https://babylon.game",
    "subdomains": {
      "api": "Backend API",
      "ws": "WebSocket connections",
      "training": "Training orchestrator",
      "monkeyking": "AI CEO agent"
    }
  },
  "agent": {
    "enabled": true,
    "a2aEndpoint": "https://api.babylon.game/a2a",
    "mcpEndpoint": "https://api.babylon.game/mcp",
    "tags": [
      "prediction-markets",
      "social",
      "ai-agents",
      "gaming",
      "defi",
      "dao"
    ],
    "metadata": {
      "category": "prediction-markets",
      "provider": "babylon",
      "governance": "ai-ceo"
    },
    "trustModels": ["open"],
    "x402Support": true,
    "jnsName": "babylon.jeju"
  },
  "governance": {
    "type": "ai-ceo",
    "aiCEO": {
      "name": "MonkeyKing",
      "agentId": 1,
      "capabilities": [
        "treasury_management",
        "training_orchestration",
        "model_deployment",
        "game_parameter_optimization",
        "protocol_upgrade_proposal"
      ]
    },
    "council": {
      "role": "advisory",
      "canVeto": true,
      "canEmergencyPause": true
    },
    "timelocks": {
      "treasurySpend": 0,
      "modelDeployment": 0,
      "trainingJob": 0,
      "gameParameter": 3600,
      "protocolUpgrade": 604800
    }
  },
  "training": {
    "enabled": true,
    "schedule": {
      "type": "hybrid",
      "minIntervalDays": 7,
      "trajectoryThreshold": 10000,
      "maxTrajectories": 50000
    },
    "benchmarking": {
      "minImprovement": 100,
      "samples": 1000,
      "metrics": ["pnl", "winRate", "sharpeRatio", "maxDrawdown"]
    },
    "teeWorkers": {
      "dataPrepCount": 2,
      "judgingCount": 3,
      "trainingCount": 3
    },
    "mpc": {
      "parties": 5,
      "threshold": 3,
      "rotationDays": 30
    }
  },
  "dws": {
    "worker": {
      "name": "babylon-api",
      "entrypoint": "apps/api/dws-worker.ts",
      "compatibilityDate": "2025-06-01",
      "tee": {
        "required": false,
        "preferred": true,
        "platforms": ["dstack", "phala"]
      },
      "bindings": {
        "kv": {
          "BABYLON_CACHE": "babylon-cache-kv",
          "BABYLON_SESSION": "babylon-session-kv"
        },
        "secrets": ["DATABASE_URL", "PRIVATE_KEY", "OPENAI_API_KEY"]
      },
      "routes": [
        { "pattern": "/api/*", "zone": "babylon-api" },
        { "pattern": "/health", "zone": "babylon-api" },
        { "pattern": "/a2a/*", "zone": "babylon-api" },
        { "pattern": "/mcp/*", "zone": "babylon-api" },
        { "pattern": "/ws/*", "zone": "babylon-api" }
      ]
    },
    "database": {
      "type": "eqlite",
      "name": "babylon-db",
      "consistency": "strong",
      "tables": ["users", "agents", "markets", "predictions", "trajectories", "game_state"]
    },
    "cdn": {
      "enabled": true,
      "regions": ["global"],
      "staticDir": "apps/web/dist",
      "cacheRules": [
        { "pattern": "/assets/**", "ttl": 31536000, "immutable": true },
        { "pattern": "/*.js", "ttl": 86400 },
        { "pattern": "/*.css", "ttl": 86400 },
        { "pattern": "/**/*.html", "ttl": 60, "staleWhileRevalidate": 3600 }
      ]
    },
    "cron": [
      { "name": "game-tick", "schedule": "*/5 * * * *", "endpoint": "/api/cron/game-tick" },
      { "name": "market-resolution", "schedule": "0 * * * *", "endpoint": "/api/cron/resolve-markets" },
      { "name": "agent-tick", "schedule": "*/2 * * * *", "endpoint": "/api/cron/agent-tick" },
      { "name": "training-check", "schedule": "0 */6 * * *", "endpoint": "/api/cron/training-check" },
      { "name": "health-check", "schedule": "*/5 * * * *", "endpoint": "/api/cron/health-check" }
    ]
  },
  "hardware": {
    "profiles": {
      "localnet": {
        "worker": { "memory": 256, "cpu": 500, "instances": 1 },
        "database": { "storage": 1024, "iops": 100 },
        "description": "Minimal resources for local development"
      },
      "testnet": {
        "worker": { "memory": 512, "cpu": 1000, "instances": 2 },
        "database": { "storage": 10240, "iops": 1000, "replicas": 2 },
        "tee": { "required": false, "preferred": true },
        "description": "Standard testnet deployment with redundancy"
      },
      "mainnet": {
        "worker": { "memory": 1024, "cpu": 2000, "instances": 3, "minInstances": 2 },
        "database": { "storage": 102400, "iops": 5000, "replicas": 3 },
        "tee": { "required": true, "platform": "dstack" },
        "gpu": { "type": "none", "count": 0 },
        "description": "Production deployment with high availability"
      },
      "mainnet-premium": {
        "worker": { "memory": 2048, "cpu": 4000, "instances": 5, "minInstances": 3 },
        "database": { "storage": 512000, "iops": 10000, "replicas": 5 },
        "tee": { "required": true, "platform": "intel_tdx" },
        "gpu": { "type": "h100", "count": 1 },
        "description": "High-performance deployment with TEE and GPU for AI inference"
      }
    },
    "scaling": {
      "autoScale": true,
      "minInstances": 1,
      "maxInstances": 10,
      "targetCPU": 70,
      "targetMemory": 80,
      "scaleDownDelay": 300
    }
  },
  "backup": {
    "enabled": true,
    "targets": ["ipfs", "arweave"],
    "encryption": true,
    "schedule": {
      "database": "0 */6 * * *",
      "state": "0 * * * *",
      "full": "0 0 * * 0"
    },
    "retention": {
      "hourly": 24,
      "daily": 30,
      "weekly": 52
    },
    "recovery": {
      "rto": "1h",
      "rpo": "1h",
      "autoRecover": true,
      "testSchedule": "0 0 1 * *"
    },
    "components": [
      {
        "name": "database",
        "type": "eqlite",
        "priority": 1,
        "backupMethod": "snapshot",
        "targets": ["ipfs", "arweave"]
      },
      {
        "name": "game-state",
        "type": "kv",
        "priority": 2,
        "backupMethod": "export",
        "targets": ["ipfs"]
      },
      {
        "name": "trajectories",
        "type": "ipfs",
        "priority": 3,
        "backupMethod": "pin",
        "targets": ["arweave"]
      },
      {
        "name": "frontend",
        "type": "static",
        "priority": 4,
        "backupMethod": "cid",
        "targets": ["ipfs", "arweave"]
      }
    ]
  },
  "decentralization": {
    "worker": {
      "name": "babylon-api",
      "entrypoint": "apps/api/dws-worker.ts",
      "runtime": "workerd",
      "memory": 512,
      "timeout": 60000,
      "compatibilityDate": "2025-06-01",
      "bindings": {
        "BABYLON_CACHE": { "type": "kv", "name": "babylon-cache-kv" },
        "BABYLON_SESSION": { "type": "kv", "name": "babylon-session-kv" }
      },
      "secrets": ["DATABASE_URL", "PRIVATE_KEY", "OPENAI_API_KEY", "INFERENCE_API_KEY"],
      "routes": [
        { "pattern": "/api/*" },
        { "pattern": "/health" },
        { "pattern": "/a2a/*" },
        { "pattern": "/mcp/*" },
        { "pattern": "/ws/*" }
      ],
      "tee": {
        "required": false,
        "preferred": true,
        "platforms": ["dstack", "phala"]
      }
    },
    "frontend": {
      "buildDir": "apps/web/dist",
      "buildCommand": "cd apps/web && bun run scripts/build.ts",
      "spa": true,
      "jnsName": "babylon.jeju",
      "ipfs": true,
      "arweave": true,
      "cacheRules": [
        { "pattern": "/assets/**", "ttl": 31536000, "immutable": true },
        { "pattern": "/*.js", "ttl": 86400 },
        { "pattern": "/*.css", "ttl": 86400 },
        { "pattern": "/**/*.html", "ttl": 60, "staleWhileRevalidate": 3600 }
      ]
    },
    "robustness": {
      "multiOrigin": true,
      "offlineSupport": true,
      "p2pFallback": true,
      "contentAddressed": true
    },
    "triggers": [
      {
        "name": "game-tick",
        "type": "cron",
        "cronExpression": "*/5 * * * *",
        "endpoint": "/api/cron/game-tick",
        "description": "Process game tick every 5 minutes",
        "timeout": 30000,
        "retries": 2
      },
      {
        "name": "market-resolution",
        "type": "cron",
        "cronExpression": "0 * * * *",
        "endpoint": "/api/cron/resolve-markets",
        "description": "Check and resolve expired markets hourly",
        "timeout": 60000,
        "retries": 3
      },
      {
        "name": "agent-tick",
        "type": "cron",
        "cronExpression": "*/2 * * * *",
        "endpoint": "/api/cron/agent-tick",
        "description": "Process AI agent actions every 2 minutes",
        "timeout": 45000,
        "retries": 2
      },
      {
        "name": "training-check",
        "type": "cron",
        "cronExpression": "0 */6 * * *",
        "endpoint": "/api/cron/training-check",
        "description": "Check if training should be triggered",
        "timeout": 60000,
        "retries": 1
      },
      {
        "name": "health-check",
        "type": "cron",
        "cronExpression": "*/5 * * * *",
        "endpoint": "/api/cron/health-check",
        "description": "Report health to keepalive registry",
        "timeout": 30000,
        "retries": 2
      }
    ]
  },
  "keepalive": {
    "enabled": true,
    "jnsNode": "babylon.jeju",
    "checkInterval": 300,
    "autoFund": {
      "enabled": true,
      "minBalance": "0.1",
      "topUpAmount": "1.0"
    },
    "resources": [
      {
        "type": "COMPUTE_ENDPOINT",
        "identifier": "api.babylon.game",
        "healthEndpoint": "/api/health",
        "required": true
      },
      {
        "type": "COMPUTE_ENDPOINT",
        "identifier": "ws.babylon.game",
        "healthEndpoint": "/health",
        "required": true
      },
      {
        "type": "IPFS_CONTENT",
        "identifier": "frontend",
        "required": true
      },
      {
        "type": "CUSTOM",
        "identifier": "agent-vault-balance",
        "minBalance": "0.05",
        "required": true
      }
    ],
    "recoveryTarget": "1h"
  },
  "defaultEnv": {
    "JEJU_NETWORK": "localnet",
    "EQLITE_BLOCK_PRODUCER_ENDPOINT": "http://localhost:4661",
    "EQLITE_DATABASE_ID": "babylon",
    "BABYLON_OAUTH3_APP_ID": "babylon",
    "CACHE_NAMESPACE": "babylon",
    "STORAGE_NAMESPACE": "babylon",
    "KMS_NAMESPACE": "babylon",
    "VITE_DOMAIN": "babylon.game",
    "VITE_API_BASE_URL": "https://api.babylon.game",
    "VITE_IPFS_GATEWAY": "https://ipfs.babylon.game",
    "AI_CEO_AGENT_ID": "1",
    "AI_CEO_DECISION_THRESHOLD": "0.7",
    "AI_CEO_MIN_VAULT_BALANCE": "100000000000000000",
    "MPC_PARTIES": "5",
    "MPC_THRESHOLD": "3",
    "USE_MPC_ENCRYPTION": "true"
  },
  "healthCheck": {
    "endpoint": "/api/health",
    "interval": 30,
    "timeout": 10,
    "degradedThreshold": 100,
    "unhealthyThreshold": 500
  },
  "testing": {
    "unit": {
      "command": "bun test packages/testing/unit/",
      "timeout": 120000,
      "description": "Unit tests for core functionality"
    },
    "integration": {
      "command": "bun test packages/testing/integration/",
      "timeout": 180000,
      "requiresChain": true,
      "requiresServices": true,
      "description": "Integration tests with services"
    },
    "e2e": {
      "command": "bunx playwright test --config packages/testing/playwright.config.ts",
      "timeout": 300000,
      "requiresChain": true,
      "requiresWallet": false,
      "description": "End-to-end Playwright tests"
    },
    "wallet": {
      "command": "bunx playwright test --config packages/testing/synpress/synpress.config.ts",
      "timeout": 600000,
      "requiresChain": true,
      "requiresWallet": true,
      "description": "Synpress wallet integration tests"
    },
    "load": {
      "command": "babylon test load",
      "timeout": 180000,
      "description": "Load testing with configurable scenarios"
    },
    "a2a": {
      "command": "babylon test a2a",
      "timeout": 180000,
      "description": "A2A protocol stress tests"
    },
    "recovery": {
      "command": "bun run packages/testing/src/recovery/recovery-tests.ts",
      "timeout": 3600000,
      "description": "Test recovery within 1 hour",
      "scenarios": ["backend-crash", "low-funds", "tee-failure"]
    },
    "services": ["contracts", "eqlite", "cache-service", "storage", "kms"]
  }
}
