{
  "name": "@babylon/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Babylon CLI - Unified command-line interface",
  "type": "module",
  "bin": {
    "babylon": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --external '@babylon/*' --external '@jejunetwork/*' --external 'archiver'",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babylon/agents": "workspace:*",
    "@babylon/api": "workspace:*",
    "@babylon/db": "workspace:*",
    "@babylon/engine": "workspace:*",
    "@babylon/shared": "workspace:*",
    "@babylon/testing": "workspace:*",
    "@babylon/training": "workspace:*",
    "@jejunetwork/config": "workspace:*",
    "@jejunetwork/sdk": "workspace:*",
    "uuid": "^13.0.0",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "bun-types": "^1.3.2",
    "typescript": "5.9.3"
  }
}
