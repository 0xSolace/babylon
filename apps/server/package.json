{
  "name": "@babylon/server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Babylon API Server - Elysia backend for Babylon services",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "elysia": "^1.4.19",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/eden": "^1.4.0",
    "@elysiajs/jwt": "^1.2.0",
    "jose": "^6.1.3",
    "@babylon/db": "workspace:*",
    "@babylon/api": "workspace:*",
    "@babylon/agents": "workspace:*",
    "@babylon/shared": "workspace:*",
    "@babylon/a2a": "workspace:*",
    "@babylon/mcp": "workspace:*",
    "@babylon/engine": "workspace:*",
    "@jejunetwork/auth": "workspace:*",
    "@babylon/training": "workspace:*",
    "@jejunetwork/training": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "bun-types": "^1.3.2",
    "typescript": "5.9.3"
  }
}
