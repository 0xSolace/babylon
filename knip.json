{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts"],
      "project": ["scripts/**/*.ts"],
      "ignore": ["**/dist/**", "**/node_modules/**"]
    },
    "apps/cli": {
      "entry": ["src/index.ts", "src/commands/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/docs": {
      "entry": ["pages/**/*.{ts,tsx,mdx}", "vocs.config.ts", "scripts/**/*.ts"],
      "project": ["**/*.{ts,tsx}"],
      "ignore": ["pages/_generated/**"]
    },
    "apps/server": {
      "entry": ["src/index.ts", "src/app.ts"],
      "project": ["src/**/*.ts"],
      "ignore": [
        "src/middleware/auth.ts"
      ]
    },
    "apps/web": {
      "entry": ["src/main.tsx", "src/App.tsx", "vite.config.ts", "tailwind.config.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "src/app/api/**",
        "src/app/api-docs/**",
        "src/types/markets.ts",
        "src/components/ui/badge.tsx",
        "src/components/ui/dialog.tsx",
        "src/config/index.ts",
        "src/hooks/usePerpMarkets.ts",
        "src/hooks/usePostHog.ts",
        "src/hooks/usePredictionMarketStream.ts",
        "src/lib/eden-client.ts",
        "src/lib/posthog/client.ts",
        "src/stores/perpMarketsStore.ts",
        "src/stores/predictionMarketsStore.ts",
        "src/components/providers/FarcasterMiniAppProvider.tsx",
        "src/components/airdrop/AirdropCard.tsx",
        "src/components/feedback/ScoreSlider.tsx",
        "src/components/feedback/StarRating.tsx",
        "src/components/shared/Avatar.tsx",
        "src/components/shared/Skeleton.tsx",
        "src/lib/api-fetch.ts"
      ]
    },
    "packages/a2a": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["src/types/a2a.ts"]
    },
    "packages/agents": {
      "entry": ["src/index.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts"],
      "ignore": [
        "src/autonomous/DecentralizedDMService.ts",
        "src/farcaster/FarcasterPostingService.ts",
        "src/autonomous/schemas/llm-response-schemas.ts",
        "src/plugins/babylon/types.ts",
        "src/plugins/babylon/integration-a2a-sdk.ts",
        "src/plugins/babylon/providers/npc-game-context.ts",
        "src/utils/prompt-logger.ts"
      ]
    },
    "packages/api": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignore": [
        "src/admin-middleware.ts",
        "src/auth-middleware.ts",
        "src/error-handler.ts",
        "src/rate-limiting/middleware.ts",
        "src/services/checkpoint-service.ts",
        "src/services/claude-service.ts",
        "src/services/ico-automation-service.ts",
        "src/services/kms-integration.ts",
        "src/tee/babylon-enclave.ts",
        "src/tee/dstack-integration.ts",
        "src/utils/type-guards.ts",
        "src/redis/client.ts",
        "src/services/eliza-holder-airdrop-service.ts"
      ]
    },
    "packages/auth": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "src/client/browser-stubs.ts",
        "src/mpc/index.ts",
        "src/oauth/index.ts",
        "src/oauth/siwe.ts",
        "src/oauth/siwf.ts",
        "src/did/index.ts",
        "src/types/guards.ts",
        "src/types/index.ts",
        "src/schemas/index.ts",
        "src/oauth/types.ts"
      ]
    },
    "packages/client": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignore": [
        "src/eqlite-driver.ts",
        "src/eqlite-schema-types.ts",
        "src/decentralized/**",
        "src/schema/misc.ts",
        "src/schema/trading.ts",
        "src/model-types.ts",
        "src/table-registry.ts",
        "src/types.ts",
        "src/type-guards.ts",
        "src/logger.ts",
        "src/json-storage.ts"
      ]
    },
    "packages/engine": {
      "entry": ["src/index.ts", "examples/**/*.ts"],
      "project": ["src/**/*.ts"],
      "ignore": [
        "src/__tests__/**",
        "src/prompts/reality-grounding.ts",
        "src/services/story-seed-service.ts",
        "src/services/topic-diversity-service.ts",
        "src/utils/context-limits.ts",
        "src/utils/date-utils.ts",
        "src/utils/shared-utils.ts",
        "src/GameGenerator.ts",
        "src/types/perps.ts"
      ]
    },
    "packages/mcp": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/messaging": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignore": [
        "src/storage/decentralized-storage.ts",
        "src/storage/index.ts"
      ]
    },
    "packages/moderation": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["src/schemas.ts", "src/a2a-handler.ts", "src/types.ts"]
    },
    "packages/plugin-babylon": {
      "entry": ["src/index.ts", "build.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/shared": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/testing": {
      "entry": [
        "src/**/*.ts",
        "unit/**/*.ts",
        "integration/**/*.ts",
        "e2e/**/*.ts",
        "synpress/**/*.ts",
        "playwright.config.ts",
        "helpers/**/*.{ts,tsx}",
        "shared/**/*.ts",
        "types/**/*.ts"
      ],
      "project": ["**/*.{ts,tsx}"],
      "ignore": ["infrastructure/setup.ts"]
    },
    "packages/training": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignore": [
        "src/compute/dws-client.ts",
        "src/training/ModelSelectionService.ts",
        "src/type-guards.ts",
        "src/compute/decentralized-training.ts",
        "src/huggingface/shared/HuggingFaceUploadUtil.ts",
        "src/schemas.ts",
        "src/training/TrajectoryRecorder.ts"
      ]
    }
  },
  "ignore": [
    "**/dist/**",
    "**/node_modules/**",
    "**/*.d.ts",
    "**/coverage/**",
    "**/test-results/**",
    "**/benchmark-output/**",
    "**/training-data/**",
    "space-system/**"
  ],
  "ignoreDependencies": [
    "@types/*",
    "husky",
    "lint-staged",
    "@biomejs/biome",
    "tsx",
    "@nomicfoundation/hardhat-toolbox",
    "csv-parse",
    "@prb/math",
    "posthog-node",
    "@jejunetwork/*",
    "elysia",
    "@elysiajs/*",
    "jose",
    "arctic",
    "@tanstack/react-query",
    "react-dom",
    "@farcaster/hub-nodejs",
    "dotenv",
    "swagger-jsdoc"
  ],
  "ignoreBinaries": [
    "forge",
    "cast",
    "which",
    "pkill",
    "lsof",
    "jeju",
    "scripts/validation/check-environment.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "exclude": ["enumMembers", "duplicates"]
}
