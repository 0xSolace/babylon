{
  "name": "babylon",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/examples/*"
  ],
  "scripts": {
    "postinstall": "bun run scripts/postinstall-solidity-deps.ts && bun run scripts/postinstall-install-python-deps.ts",
    "babylon": "bun run apps/cli/src/index.ts",
    "dev": "bun run apps/cli/src/index.ts dev",
    "dev:web": "turbo dev --filter=babylon-web",
    "build": "turbo build",
    "build:static": "bun run apps/cli/src/index.ts deploy build",
    "typecheck": "turbo typecheck",
    "lint": "biome check --write --unsafe .",
    "check": "biome check --write .",
    "db:seed": "bun run apps/cli/src/index.ts db seed",
    "db:status": "bun run apps/cli/src/index.ts db status",
    "docs:generate": "bun run apps/cli/src/index.ts docs all",
    "docs:vendors": "bun run apps/cli/src/index.ts docs vendors",
    "game:tick": "bun run apps/cli/src/index.ts game tick",
    "game:cron": "bun run apps/cli/src/index.ts game cron",
    "deploy:local": "bun run apps/cli/src/index.ts deploy local",
    "deploy:testnet": "bun run apps/cli/src/index.ts deploy testnet",
    "deploy:mainnet": "bun run apps/cli/src/index.ts deploy mainnet --force",
    "deploy:frontend": "bun run apps/cli/src/index.ts deploy frontend",
    "deploy:ipfs": "bun run apps/cli/src/index.ts deploy ipfs",
    "knip": "knip",
    "knip:fix": "knip --fix"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.5",
    "js-tiktoken": "^1.0.21",
    "viem": "2.43.3",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@playwright/test": "1.57.0",
    "@prb/math": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "bun-types": "^1.3.2",
    "csv-parse": "^6.1.0",
    "hardhat": "2.22.18",
    "husky": "^9.1.7",
    "knip": "^5.77.1",
    "lint-staged": "^16.2.6",
    "posthog-node": "^5.18.0",
    "tsx": "^4.21.0",
    "turbo": "^2.5.4",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "bun@1.3.0"
}
