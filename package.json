{
  "name": "babylon",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/examples/*"
  ],
  "scripts": {
    "postinstall": "bun run scripts/postinstall-solidity-deps.ts && bun run scripts/postinstall-install-python-deps.ts",
    "babylon": "bun run apps/cli/src/index.ts",
    "dev": "bun run apps/cli/src/index.ts dev",
    "dev:web": "turbo dev --filter=babylon-web",
    "dev:server": "bun run --watch apps/server/src/index.ts",
    "dev:hmr": "concurrently -n server,web -c blue,green \"bun run dev:server\" \"bun run dev:web\"",
    "start": "bun run apps/server/src/index.ts",
    "start:production": "bun run deploy:dws --network=testnet",
    "build": "turbo build",
    "build:worker": "bun run scripts/esbuild-backend.ts",
    "deploy:worker": "bun run scripts/deploy-backend-worker.ts",
    "deploy:worker:testnet": "NETWORK=testnet bun run scripts/deploy-backend-worker.ts",
    "deploy:worker:localnet": "NETWORK=localnet bun run scripts/deploy-backend-worker.ts",
    "test": "bun run test:setup && turbo test",
    "test:setup": "bun run packages/testing/infrastructure/setup.ts --mode=integration --deploy",
    "test:unit": "bun test packages/testing/unit/ --timeout 120000",
    "test:integration": "bun run test:setup && bun test packages/testing/integration/ --timeout 180000",
    "test:e2e": "bun run test:setup && bunx playwright test --config packages/testing/playwright.config.ts",
    "test:synpress": "bun run test:setup && bunx playwright test --config packages/testing/synpress/synpress.config.ts",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "typecheck": "turbo typecheck",
    "lint": "biome check --write --unsafe .",
    "check": "biome check --write --unsafe .",
    "db:seed": "bun run apps/cli/src/index.ts db seed",
    "db:status": "bun run apps/cli/src/index.ts db status",
    "db:migrate": "bun run apps/cli/src/index.ts db migrate",
    "docs:generate": "bun run apps/cli/src/index.ts docs all",
    "docs:vendors": "bun run apps/cli/src/index.ts docs vendors",
    "game:tick": "bun run apps/cli/src/index.ts game tick",
    "game:cron": "bun run apps/cli/src/index.ts game cron",
    "deploy:dws": "bun run scripts/deploy-dws.ts",
    "deploy:dws:localnet": "bun run scripts/deploy-dws.ts --network=localnet",
    "deploy:dws:testnet": "bun run scripts/deploy-dws.ts --network=testnet",
    "deploy:dws:mainnet": "bun run scripts/deploy-dws.ts --network=mainnet",
    "deploy:dws:dry-run": "bun run scripts/deploy-dws.ts --network=testnet --dry-run",
    "knip": "knip",
    "knip:fix": "knip --fix"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.5",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.0",
    "@farcaster/miniapp-sdk": "^0.2.1",
    "@huggingface/hub": "^2.7.1",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sinclair/typebox": "^0.34.46",
    "@tanstack/react-query": "^5.90.12",
    "@xmtp/node-sdk": "^4.6.0",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.1.0",
    "elysia": "^1.4.19",
    "graphql-request": "^7.4.0",
    "html-to-image": "^1.11.13",
    "jose": "^6.1.3",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.313.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "streamdown": "^1.6.10",
    "tailwindcss-animate": "^1.0.7",
    "viem": "^2.43.3",
    "wagmi": "^2.18.1",
    "xml2js": "^0.6.2",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@playwright/test": "1.57.0",
    "@prb/math": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "bun-types": "^1.3.2",
    "csv-parse": "^6.1.0",
    "hardhat": "2.22.18",
    "husky": "^9.1.7",
    "knip": "^5.77.1",
    "lint-staged": "^16.2.6",
    "posthog-node": "^5.18.0",
    "tsx": "^4.21.0",
    "turbo": "^2.5.4",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "bun@1.3.0"
}
