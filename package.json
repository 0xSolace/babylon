{
  "name": "babylon",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/examples/*"
  ],
  "scripts": {
    "postinstall": "bun run scripts/postinstall-solidity-deps.ts && bun run scripts/postinstall-install-python-deps.ts",
    "dev": "bun run scripts/pre-dev/pre-dev-decentralized.ts && bun run scripts/dev-wrapper.ts",
    "dev:jeju": "bun run scripts/jeju-dev.ts",
    "dev:web": "turbo dev --filter=web",
    "dev:web:staging": "NODE_ENV=development bun --env-file=.env.staging.local run dev:web",
    "dev:web:production": "NODE_ENV=development bun --env-file=.env.production.local run dev:web",
    "dev:next-only": "turbo dev:next-only --filter=web",
    "build": "turbo build",
    "build:deploy": "turbo build && bun run scripts/deploy-static-to-ipfs.ts",
    "build:static": "bun run scripts/build-static.ts",
    "build:static:testnet": "bun run scripts/build-static.ts --env testnet",
    "build:static:mainnet": "bun run scripts/build-static.ts --env mainnet",
    "start": "turbo start --filter=web",
    "deploy:frontend": "bun run scripts/deploy-frontend.ts",
    "deploy:frontend:testnet": "bun run build:static:testnet && bun run scripts/deploy-frontend.ts --env testnet",
    "deploy:frontend:mainnet": "bun run build:static:mainnet && bun run scripts/deploy-frontend.ts --env mainnet",
    "deploy:aws": "bun run scripts/deploy-frontend.ts --skip-ipfs --skip-jns",
    "deploy:ipfs": "bun run scripts/deploy-frontend.ts --skip-aws",
    "deploy:testnet:all": "bun run deploy:testnet && bun run deploy:frontend:testnet",
    "deploy:mainnet:all": "bun run deploy:mainnet && bun run deploy:frontend:mainnet",
    "infra:init": "cd packages/deployment/terraform && terraform init",
    "infra:plan:testnet": "cd packages/deployment/terraform/environments/testnet && terraform plan",
    "infra:apply:testnet": "cd packages/deployment/terraform/environments/testnet && terraform apply",
    "infra:plan:mainnet": "cd packages/deployment/terraform/environments/mainnet && terraform plan",
    "infra:apply:mainnet": "cd packages/deployment/terraform/environments/mainnet && terraform apply",
    "check": "biome check --write .",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "validate:all": "bun run typecheck && bun run lint",
    "security:audit": "bun run scripts/security-audit.ts",
    "test": "bun run scripts/test-runner.ts",
    "test:all": "bun run scripts/test-runner.ts",
    "test:unit": "bun test packages/testing/unit/ --preload ./packages/testing/unit/preload.ts",
    "test:integration": "bun test packages/testing/integration/ --preload ./packages/testing/integration/preload.ts",
    "test:e2e": "bun run scripts/test-runner.ts --e2e",
    "test:ci": "bash scripts/ci/run-all-tests.sh",
    "test:e2e:playwright": "cd packages/testing && playwright test e2e",
    "test:testnet": "bun run scripts/test-runner.ts --testnet",
    "test:localnet": "bun test packages/testing/integration/agent0-localnet.test.ts packages/testing/deployment/localnet.test.ts",
    "test:validate": "bun run scripts/test-runner.ts --validate",
    "infra:check": "bun run packages/testing/infrastructure/health-check.ts",
    "infra:start": "bun run packages/testing/infrastructure/health-check.ts --start",
    "infra:messaging": "docker-compose -f docker-compose.yml -f docker-compose.messaging.yml up -d",
    "infra:messaging:stop": "docker-compose -f docker-compose.yml -f docker-compose.messaging.yml down",
    "contracts:check": "bun run packages/testing/infrastructure/contracts.ts",
    "contracts:deploy:messaging": "bun run packages/testing/infrastructure/contracts.ts --deploy",
    "miniapp:deploy": "bash scripts/deploy-miniapp.sh",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:push": "bun run --cwd packages/db db:push",
    "db:pull": "bun run --cwd packages/db db:pull",
    "db:studio": "bun run --cwd packages/db db:studio",
    "db:check": "bun run --cwd packages/db db:check",
    "db:seed": "bun run scripts/seed-database.ts",
    "db:seed:test": "bun run scripts/seed-test-data.ts all",
    "deploy:local": "bun run apps/cli/src/index.ts deploy local",
    "deploy:testnet": "bun run apps/cli/src/index.ts deploy testnet",
    "deploy:mainnet": "bun run apps/cli/src/index.ts deploy mainnet --force",
    "hardhat": "cd packages/contracts && npx hardhat node",
    "contracts:setup": "rm -rf packages/contracts/dependencies && bun run scripts/postinstall-solidity-deps.ts",
    "contracts:test": "cd packages/contracts && forge test",
    "contracts:test:oracle": "echo 'Oracle tests now in Jeju: cd packages/contracts && forge test --match-contract GameOracleTest'",
    "contracts:deploy:local": "bun run apps/cli/src/index.ts deploy local",
    "oracle:test:e2e": "bun test packages/testing/integration/oracle-full-flow.test.ts",
    "oracle:test:betting": "bun test packages/testing/integration/betting/ packages/testing/e2e/betting-on-chain.test.ts",
    "oracle:test:integration": "bun test packages/testing/integration/oracle/",
    "agent0:setup": "bun run apps/cli/src/index.ts agent agent0-config",
    "babylon": "bun run apps/cli/src/index.ts",
    "testnet:setup": "bun run apps/cli/src/index.ts deploy setup",
    "hf:collect": "bun run apps/cli/src/index.ts model collect-data",
    "hf:upload": "bun run apps/cli/src/index.ts model upload-dataset",
    "stress-test": "bun run apps/cli/src/index.ts test load",
    "stress-test:a2a": "bun run apps/cli/src/index.ts test a2a",
    "prepare": "husky",
    "docs:generate": "bun scripts/docs/generate_all_docs.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.5",
    "import-in-the-middle": "^2.0.0",
    "require-in-the-middle": "^8.0.1",
    "viem": "^2.41.2",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@prb/math": "^4.1.0",
    "@playwright/test": "^1.56.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.0",
    "bun-types": "^1.3.2",
    "concurrently": "^9.2.1",
    "csv-parse": "^6.1.0",
    "hardhat": "2.22.18",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "tsx": "^4.21.0",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "bun@1.3.0",
  "trustedDependencies": [
    "@reown/appkit",
    "@sentry/cli",
    "@tree-sitter-grammars/tree-sitter-yaml",
    "core-js",
    "core-js-pure",
    "protobufjs"
  ]
}
