{
  "name": "babylon",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/examples/*"
  ],
  "scripts": {
    "postinstall": "bun run scripts/postinstall-solidity-deps.ts && bun run scripts/postinstall-install-python-deps.ts",
    "babylon": "bun run apps/cli/src/index.ts",
    
    "dev": "bun run apps/cli/src/index.ts dev",
    "dev:web": "turbo dev --filter=babylon-web",
    "dev:server": "bun run --watch apps/server/src/index.ts",
    "dev:hmr": "concurrently -n server,web -c blue,green \"bun run dev:server\" \"bun run dev:web\"",
    
    "start": "bun run apps/server/src/index.ts",
    "start:production": "bun run apps/cli/src/index.ts deploy dws --env=localnet && bun run apps/cli/src/index.ts deploy ipfs",
    "start:static": "bun run build:static && bun run deploy:ipfs && bun run deploy:dws-local",
    
    "build": "turbo build",
    "build:static": "bun run apps/cli/src/index.ts deploy build --env=local",
    "build:testnet": "bun run apps/cli/src/index.ts deploy build --env=testnet",
    "build:mainnet": "bun run apps/cli/src/index.ts deploy build --env=mainnet",
    "build:worker": "bun build apps/api/dws-worker.ts --outdir dist/worker --target bun --minify",
    
    "test": "bun run test:setup && turbo test",
    "test:setup": "bun run packages/testing/infrastructure/setup.ts --mode=integration --deploy",
    "test:unit": "bun test packages/testing/unit/ --timeout 120000",
    "test:integration": "bun run test:setup && bun test packages/testing/integration/ --timeout 180000",
    "test:e2e": "bun run test:setup && bunx playwright test --config packages/testing/playwright.config.ts",
    "test:synpress": "bun run test:setup && bunx playwright test --config packages/testing/synpress/synpress.config.ts",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e",
    
    "typecheck": "turbo typecheck",
    "lint": "biome check --write --unsafe .",
    "check": "biome check --write --unsafe .",
    
    "db:seed": "bun run apps/cli/src/index.ts db seed",
    "db:status": "bun run apps/cli/src/index.ts db status",
    "db:migrate": "bun run apps/cli/src/index.ts db migrate",
    
    "docs:generate": "bun run apps/cli/src/index.ts docs all",
    "docs:vendors": "bun run apps/cli/src/index.ts docs vendors",
    
    "game:tick": "bun run apps/cli/src/index.ts game tick",
    "game:cron": "bun run apps/cli/src/index.ts game cron",
    
    "deploy": "bun run apps/cli/src/index.ts deploy",
    "deploy:local": "bun run apps/cli/src/index.ts deploy local",
    "deploy:dws-local": "bun run apps/cli/src/index.ts deploy dws --env=testnet --dry-run",
    "deploy:testnet": "bun run build:testnet && bun run apps/cli/src/index.ts deploy testnet && bun run apps/cli/src/index.ts deploy full --env=testnet",
    "deploy:mainnet": "bun run build:mainnet && bun run apps/cli/src/index.ts deploy mainnet --force && bun run apps/cli/src/index.ts deploy full --env=mainnet",
    "deploy:frontend": "bun run apps/cli/src/index.ts deploy frontend",
    "deploy:ipfs": "bun run apps/cli/src/index.ts deploy ipfs",
    "deploy:dws": "bun run apps/cli/src/index.ts deploy dws",
    "deploy:full": "bun run apps/cli/src/index.ts deploy full",
    
    "knip": "knip",
    "knip:fix": "knip --fix"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.5",
    "js-tiktoken": "^1.0.21",
    "viem": "2.43.3",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@playwright/test": "1.57.0",
    "@prb/math": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "bun-types": "^1.3.2",
    "csv-parse": "^6.1.0",
    "hardhat": "2.22.18",
    "husky": "^9.1.7",
    "knip": "^5.77.1",
    "lint-staged": "^16.2.6",
    "posthog-node": "^5.18.0",
    "tsx": "^4.21.0",
    "turbo": "^2.5.4",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "bun@1.3.0"
}
