{
  "name": "@babylon/contracts",
  "version": "0.0.1",
  "description": "Babylon Smart Contract ABIs and clients",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/"
  },
  "dependencies": {
    "@babylon/shared": "workspace:*",
    "viem": "^2.43.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0"
  }
}
