{
  "name": "@babylon/db",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Babylon Database Layer - CovenantQL (CQL)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts",
      "require": "./src/schema/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts",
      "require": "./src/types.ts"
    },
    "./validation": {
      "types": "./src/validation/index.ts",
      "import": "./src/validation/index.ts",
      "require": "./src/validation/index.ts"
    },
    "./moderation/filters": {
      "types": "./src/moderation/filters.ts",
      "import": "./src/moderation/filters.ts",
      "require": "./src/moderation/filters.ts"
    },
    "./decentralized": {
      "types": "./src/decentralized/index.ts",
      "import": "./src/decentralized/index.ts",
      "require": "./src/decentralized/index.ts"
    }
  },
  "scripts": {
    "lint": "biome lint .",
    "typecheck": "tsc -b .",
    "db:generate": "tsx ../../node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx ../../node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "tsx ../../node_modules/drizzle-kit/bin.cjs push",
    "db:pull": "tsx ../../node_modules/drizzle-kit/bin.cjs pull",
    "db:studio": "tsx ../../node_modules/drizzle-kit/bin.cjs studio",
    "db:check": "tsx ../../node_modules/drizzle-kit/bin.cjs check"
  },
  "dependencies": {
    "@babylon/shared": "workspace:*",
    "@jejunetwork/db": "workspace:*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}
