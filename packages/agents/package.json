{
  "name": "@babylon/agents",
  "version": "0.1.0",
  "private": true,
  "description": "Babylon Agent System - AI agents, plugins, and services",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts",
      "require": "./src/client.ts"
    }
  },
  "scripts": {
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "register-fids": "bun run scripts/register-npc-fids.ts",
    "register-fids:dry-run": "bun run scripts/register-npc-fids.ts --dry-run"
  },
  "dependencies": {
    "@babylon/a2a": "workspace:*",
    "@babylon/api": "workspace:*",
    "@jejunetwork/db": "workspace:*",
    "viem": "^2.43.2"
  },
  "peerDependencies": {
    "@a2a-js/sdk": "^0.3.5",
    "@babylon/core": "workspace:*",
    "@babylon/db": "workspace:*",
    "@babylon/engine": "workspace:*",
    "@babylon/shared": "workspace:*",
    "@babylon/training": "workspace:*",
    "@jejunetwork/sdk": "workspace:*",
    "@elizaos/core": "^1.6.4",
    "@huggingface/hub": "^2.6.12",
    "agent0-sdk": "^0.31.0",
    "ai": "^5.0.106",
    "graphql-request": "^7.3.3",
    "tiktoken": "^1.0.22",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "bun-types": "^1.3.2",
    "graphql-request": "^7.3.3",
    "typescript": "^5.9.3"
  }
}
