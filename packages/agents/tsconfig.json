{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["bun-types"],
    "baseUrl": "../../../..",
    "paths": {
      "@babylon/shared": ["vendor/babylon/packages/shared/src/index.ts"],
      "@babylon/shared/*": ["vendor/babylon/packages/shared/src/*"],
      "@babylon/db": ["vendor/babylon/packages/db/src/index.ts"],
      "@babylon/db/*": ["vendor/babylon/packages/db/src/*"],
      "@babylon/engine": ["vendor/babylon/packages/engine/src/index.ts"],
      "@babylon/engine/*": ["vendor/babylon/packages/engine/src/*"],
      "@babylon/core": ["vendor/babylon/packages/core/markets/index.ts"],
      "@babylon/core/*": ["vendor/babylon/packages/core/*"],
      "@babylon/api": ["vendor/babylon/packages/api/src/index.ts"],
      "@babylon/api/storage": ["vendor/babylon/packages/api/src/storage/index.ts"],
      "@babylon/api/*": ["vendor/babylon/packages/api/src/*"],
      "@babylon/a2a": ["vendor/babylon/packages/a2a/src/index.ts"],
      "@babylon/a2a/*": ["vendor/babylon/packages/a2a/src/*"],
      "@babylon/auth": ["vendor/babylon/packages/auth/src/index.ts"],
      "@babylon/auth/*": ["vendor/babylon/packages/auth/src/*"],
      "@babylon/training": ["vendor/babylon/packages/training/src/index.ts"],
      "@babylon/training/*": ["vendor/babylon/packages/training/src/*"],
      "@babylon/agents": ["vendor/babylon/packages/agents/src/index.ts"],
      "@babylon/agents/*": ["vendor/babylon/packages/agents/src/*"],
      "@jejunetwork/shared": ["packages/shared/src/index.ts"],
      "@jejunetwork/shared/*": ["packages/shared/src/*"],
      "@jejunetwork/types": ["packages/types/src/index.ts"],
      "@jejunetwork/types/*": ["packages/types/src/*"],
      "@jejunetwork/agents": ["packages/agents/src/index.ts"],
      "@jejunetwork/agents/*": ["packages/agents/src/*"],
      "@jejunetwork/training": ["packages/training/src/index.ts"],
      "@jejunetwork/training/*": ["packages/training/src/*"],
      "@jejunetwork/config": ["packages/config/src/index.ts"],
      "@jejunetwork/config/*": ["packages/config/src/*"],
      "@jejunetwork/contracts": ["packages/contracts/src/index.ts"],
      "@jejunetwork/contracts/*": ["packages/contracts/src/*"],
      "@jejunetwork/db": ["packages/db/src/index.ts"],
      "@jejunetwork/db/*": ["packages/db/src/*"],
      "@jejunetwork/auth": ["packages/auth/src/index.ts"],
      "@jejunetwork/auth/*": ["packages/auth/src/*"],
      "@jejunetwork/messaging": ["packages/messaging/src/index.ts"],
      "@jejunetwork/messaging/*": ["packages/messaging/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
