{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "baseUrl": ".",
    "paths": {
      "@babylon/shared": ["../shared/src/index.ts"],
      "@babylon/shared/*": ["../shared/src/*"],
      "@babylon/db": ["../db/src/index.ts"],
      "@babylon/db/*": ["../db/src/*"],
      "@babylon/engine": ["../engine/src/index.ts"],
      "@babylon/engine/*": ["../engine/src/*"],
      "@babylon/core": ["../core/markets/index.ts"],
      "@babylon/core/*": ["../core/*"],
      "@babylon/api": ["../api/src/index.ts"],
      "@babylon/api/storage": ["../api/src/storage/index.ts"],
      "@babylon/api/*": ["../api/src/*"],
      "@babylon/a2a": ["../a2a/src/index.ts"],
      "@babylon/a2a/*": ["../a2a/src/*"],
      "@babylon/training": ["../training/src/index.ts"],
      "@babylon/training/*": ["../training/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
