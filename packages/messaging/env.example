# Decentralized Messaging Configuration
# Copy to .env and update values for your environment

# =============================================================================
# JEJU L2 CONFIGURATION
# =============================================================================

# Jeju L2 RPC URL
JEJU_RPC_URL=https://testnet-rpc.jeju.network

# KeyRegistry contract address (deployed on Jeju L2)
KEY_REGISTRY_ADDRESS=0x...

# MessageNodeRegistry contract address (deployed on Jeju L2)
NODE_REGISTRY_ADDRESS=0x...

# =============================================================================
# COVENANTSQL CONFIGURATION
# =============================================================================

# Comma-separated list of CovenantSQL node URLs
COVENANTSQL_NODES=http://cql1.testnet.jeju.network:8546,http://cql2.testnet.jeju.network:8546,http://cql3.testnet.jeju.network:8546

# Database ID for messaging
COVENANTSQL_DATABASE_ID=babylon-messaging

# CovenantSQL authentication private key (secp256k1)
COVENANTSQL_PRIVATE_KEY=0x...

# =============================================================================
# KMS CONFIGURATION
# =============================================================================

# Jeju KMS API endpoint
JEJU_KMS_ENDPOINT=https://kms.testnet.jeju.network

# KMS API key (for authenticated operations)
JEJU_KMS_API_KEY=

# =============================================================================
# RELAY NODE CONFIGURATION
# =============================================================================

# Messaging relay endpoint
RELAY_NODE_URL=https://relay.testnet.jeju.network

# WebSocket relay endpoint (for real-time updates)
RELAY_WS_URL=wss://relay.testnet.jeju.network/ws

# =============================================================================
# FARCASTER CONFIGURATION
# =============================================================================

# Farcaster Hub gRPC URL
FARCASTER_HUB_URL=nemes.farcaster.xyz:2283

# Enable Farcaster FID registration for NPCs (requires gas on Optimism)
ENABLE_FARCASTER_REGISTRATION=false

# Optimism RPC URL (for Farcaster IdRegistry interactions)
OPTIMISM_RPC_URL=https://mainnet.optimism.io

# Farcaster recovery address (for FID registration)
FARCASTER_RECOVERY_KEY=

# =============================================================================
# BRIDGE CONFIGURATION (Cross-Chain Messaging)
# =============================================================================

# Base chain RPC URL
BASE_RPC_URL=https://mainnet.base.org

# Jeju ↔ Base bridge contract on Jeju
JEJU_BRIDGE_ADDRESS=0x...

# Jeju ↔ Base bridge contract on Base
BASE_BRIDGE_ADDRESS=0x...

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable decentralized messaging (vs centralized DB)
USE_DECENTRALIZED_MESSAGING=true

# Enable internal-only mode (no external Farcaster posting)
MESSAGING_INTERNAL_ONLY=true

# Enable cross-chain messaging
ENABLE_CROSS_CHAIN_MESSAGING=false

# =============================================================================
# OPERATOR CONFIGURATION (for running relay nodes)
# =============================================================================

# Relay node operator private key (for on-chain registration)
OPERATOR_PRIVATE_KEY=0x...

# Node region for geographic routing
RELAY_NODE_REGION=us-east-1

# Staking amount for relay node registration (in ETH)
RELAY_NODE_STAKE=0.1

