{
  "name": "@babylon/messaging",
  "version": "1.0.0",
  "description": "Decentralized messaging integration for Babylon using Jeju L2",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./react": {
      "import": "./src/react/index.ts",
      "types": "./src/react/index.ts"
    },
    "./farcaster": {
      "import": "./src/farcaster/index.ts",
      "types": "./src/farcaster/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@jejunetwork/db": "workspace:*",
    "@noble/ciphers": "^1.2.1",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "viem": "^2.41.2"
  },
  "devDependencies": {
    "@farcaster/hub-nodejs": "^0.14.1",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
