{
  "name": "@babylon/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Shared testing utilities and test suites for Babylon",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test unit/ --preload ./unit/preload.ts",
    "test:integration": "bun test integration/ --preload ./integration/preload.ts",
    "test:e2e": "playwright test e2e/",
    "test:synpress": "playwright test --config=synpress.config.ts"
  },
  "dependencies": {
    "@babylon/api": "workspace:*",
    "@babylon/auth": "workspace:*",
    "@babylon/shared": "workspace:*",
    "@babylon/engine": "workspace:*",
    "@babylon/db": "workspace:*",
    "@babylon/agents": "workspace:*",
    "@babylon/a2a": "workspace:*",
    "@babylon/training": "workspace:*",
    "@babylon/contracts": "workspace:*",
    "@babylon/messaging": "workspace:*",
    "@tanstack/react-query": "^5.90.8",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@synthetixio/synpress": "^4.1.1",
    "@synthetixio/synpress-cache": "^0.0.13",
    "@synthetixio/synpress-metamask": "^0.0.13",
    "dotenv": "^16.4.5",
    "next": "16.0.7",
    "playwright": "^1.56.1"
  }
}
