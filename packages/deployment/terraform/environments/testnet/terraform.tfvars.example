# Babylon Testnet Terraform Variables
# Copy this to terraform.tfvars and fill in values

# Environment
environment = "testnet"
aws_region  = "us-west-2"

# Domain Configuration
domain_name = "babylon.market"

# API Backend (update with your backend deployment)
api_origin = "api.babylon.market"

# Storage/IPFS Configuration (using Jeju infrastructure)
storage_gateway_origin = "storage.testnet.jeju.network"
ipfs_gateway_origin    = "ipfs.testnet.jeju.network"
jns_resolver_origin    = "jns.testnet.jeju.network"

# Feature Flags
enable_storage_cdn = true

