{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": ["bun-types"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "python", "**/__tests__/**/*"],
  "references": [
    { "path": "../shared" },
    { "path": "../db" },
    { "path": "../contracts" }
  ]
}
