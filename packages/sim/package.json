{
  "name": "@babylon/sim",
  "version": "0.1.0",
  "private": true,
  "description": "Babylon Sim — standalone system engine with CLI, config loading, and auto-import scanning",
  "main": "./core/index.ts",
  "types": "./core/index.ts",
  "bin": {
    "babylon": "./cli/index.ts"
  },
  "exports": {
    ".": {
      "bun": "./core/index.ts",
      "types": "./core/index.ts",
      "import": "./core/index.ts",
      "require": "./core/index.ts"
    }
  },
  "scripts": {
    "build": "bun run cli/index.ts build",
    "dev": "bun run cli/index.ts dev --legacy",
    "document": "bun run cli/index.ts document",
    "info": "bun run cli/index.ts info",
    "tick": "bun run cli/index.ts tick",
    "test": "bun test",
    "lint": "biome lint .",
    "typecheck": "tsc -b ."
  },
  "dependencies": {
    "@babylon/shared": "workspace:*",
    "@babylon/db": "workspace:*",
    "@babylon/engine": "workspace:*",
    "citty": "^0.1.6",
    "c12": "^2.0.1",
    "unimport": "^4.1.2",
    "chokidar": "^4.0.3",
    "consola": "^3.4.2",
    "hookable": "^5.5.3",
    "unctx": "^2.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "bun-types": "^1.3.2",
    "typescript": "^5.9.3"
  }
}
