{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "types": ["bun-types"],
    // Disable unused locals check - engine has some batch methods reserved for future optimization
    "noUnusedLocals": false,
    "baseUrl": ".",
    "paths": {
      "@babylon/shared": ["../shared/src/index.ts"],
      "@babylon/shared/*": ["../shared/src/*"],
      "@babylon/db": ["../db/src/index.ts"],
      "@babylon/db/*": ["../db/src/*"],
      "@babylon/core": ["../core/markets/index.ts"],
      "@babylon/core/*": ["../core/*"],
      "@babylon/agents": ["../agents/src/index.ts"],
      "@babylon/agents/*": ["../agents/src/*"],
      "@babylon/api": ["../api/src/index.ts"],
      "@babylon/api/*": ["../api/src/*"],
      "@babylon/training": ["../training/src/index.ts"],
      "@babylon/training/*": ["../training/src/*"]
    }
  },
  "include": ["src/**/*", "src/**/*.json"],
  "exclude": ["node_modules", "dist", "**/__tests__/**/*"]
}
