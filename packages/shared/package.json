{
  "name": "@babylon/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, constants, and utilities for Babylon",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./contracts/*": {
      "types": "./src/contracts/*.ts",
      "import": "./src/contracts/*.ts",
      "require": "./src/contracts/*.ts"
    }
  },
  "scripts": {
    "lint": "biome lint .",
    "typecheck": "tsc -b ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "viem": "^2.41.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
