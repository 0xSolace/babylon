{
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["ESNext", "dom"],
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "incremental": true,
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "forceConsistentCasingInFileNames": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "allowJs": true,
    "checkJs": false,
    "noEmitOnError": false,
    "moduleDetection": "force",
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx",
    "isolatedModules": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@babylon/shared": ["../shared/src/index.ts"],
      "@babylon/shared/*": ["../shared/src/*"],
      "@babylon/db": ["../db/src/index.ts"],
      "@babylon/db/*": ["../db/src/*"],
      "@babylon/core": ["../core/markets/index.ts"],
      "@babylon/core/*": ["../core/*"],
      "@babylon/engine": ["../engine/src/index.ts"],
      "@babylon/engine/*": ["../engine/src/*"],
      "@babylon/agents": ["../agents/src/index.ts"],
      "@babylon/agents/*": ["../agents/src/*"],
      "@babylon/training": ["../training/src/index.ts"],
      "@babylon/training/*": ["../training/src/*"],
      "@babylon/a2a": ["../a2a/src/index.ts"],
      "@babylon/a2a/*": ["../a2a/src/*"],
      "@babylon/auth": ["../auth/src/index.ts"],
      "@babylon/auth/*": ["../auth/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/__tests__/**/*", "e2e/**/*", "**/*.test.ts", "**/*.spec.ts"]
}
