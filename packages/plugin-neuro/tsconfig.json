{
  // skipLibCheck: true
  // Reason: This plugin has extensive type issues that need refactoring:
  // 1. Missing console/DOM types (needs proper lib configuration)
  // 2. MemoryMetadata property access (title, summary, keywords, etc. don't exist on base type)
  // 3. State | undefined incompatibility issues
  // 4. Undefined variable references (convos, convoTxt, Action)
  // 5. XML parser configuration issues
  // This is a complex research/experimental plugin that needs architectural cleanup.
  // skipLibCheck allows it to build while being refactored. Source code needs fixes.
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "target": "ES2022",
    "lib": ["ESNext", "dom"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "allowJs": true,
    "checkJs": false,
    "noEmitOnError": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "typeRoots": ["./types", "./node_modules/@types"],
    "moduleDetection": "force",
    "allowArbitraryExtensions": true
  },
  "include": ["src/**/*.ts"]
}
